{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bluebench",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Serve bluebench.dev from this Worker. Wrangler creates the DNS record and
  // certificate on deploy (the zone must already be on this Cloudflare account).
  "routes": [{ "pattern": "bluebench.dev", "custom_domain": true }],
  // The built web app. Static files are served without invoking the Worker;
  // only /api/* runs Worker code (keeps us well under 100k requests/day).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Every route is pre-rendered to its own HTML file; anything else gets dist/404.html with a real 404.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Cached lookup verdicts only (free tier: 1,000 writes/day), never counters.
  // "bluebench-verdicts", created by Wrangler's auto-provisioning on the first M3 deploy. Pinned so a
  // failed deploy can't make Wrangler try to create it again (it then fails on the duplicate name).
  "kv_namespaces": [{ "binding": "VERDICTS", "id": "6accf125a6524e5f9aa9882a44a055a8" }],
  // Accounts, saved domains, alert history and push subscriptions (free tier: 100k rows written/day).
  // Create it once with `wrangler d1 create bluebench` and paste the id here. CI applies ./migrations
  // (generated by drizzle-kit from src/db/schema.ts) before every deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bluebench",
      "database_id": "f9a1ef9f-8b4f-43c4-bee3-09d2f52f2581",
      "migrations_dir": "migrations"
    }
  ],
  // Monitoring: every minute, either deliver pending alerts or re-check the next due domain (each saved
  // domain once a day). One job per run keeps each run inside the 50-subrequest limit.
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      // One instance per upstream provider: token bucket + daily budget.
      { "name": "PROVIDER_QUOTA", "class_name": "ProviderQuota" },
      // Daily lookup caps per session and per IP group.
      { "name": "USAGE", "class_name": "UsageCounter" }
    ]
  },
  // Free plan requires SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProviderQuota", "UsageCounter"] }],
  // Per-minute limits, per session token and per IP (IPv6 grouped by /64).
  "ratelimits": [
    { "name": "TOKEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // Fresh domain reports per target domain: protects third-party sites from being hammered via us.
    { "name": "TARGET_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    // Public Turnstile site key (invisible widget for bluebench.dev). Empty = lookups switched off.
    // Invisible mode requires our privacy policy (apps/web/src/pages/PrivacyPage.tsx) to reference
    // Cloudflare's Turnstile Privacy Addendum.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFT1Dg5bCHUCflEe",
    // Where magic links point, and the zone Bluebench runs in (its own site can't be graded from inside).
    "SITE_ORIGIN": "https://bluebench.dev",
    // Sender for magic links and alert emails (Resend; the domain must be verified there).
    "EMAIL_FROM": "Bluebench <alerts@bluebench.dev>",
    // Web Push VAPID public key (base64url, 65-byte P-256 point). Empty = push switched off.
    "VAPID_PUBLIC_KEY": "BDdWLL-O2wJNGZLXWMV82f8iqKAxMQTCoQ89rz7lqhgnkZYmIHqXRszEHT_ZXs07M3jL8ENWCV9mew-CmAX21XU"
  },
  // Secrets (wrangler secret put): TURNSTILE_SECRET_KEY, SESSION_SECRET, ABUSECH_AUTH_KEY, SAFE_BROWSING_API_KEY,
  // BETTER_AUTH_SECRET, RESEND_API_KEY, VAPID_PRIVATE_KEY, CERTSPOTTER_API_KEY
  "observability": { "enabled": false },
  "send_metrics": false
}
