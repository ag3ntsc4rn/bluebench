{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bluebench",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Serve bluebench.dev from this Worker. Wrangler creates the DNS record and
  // certificate on deploy (the zone must already be on this Cloudflare account).
  "routes": [{ "pattern": "bluebench.dev", "custom_domain": true }],
  // The built web app. Static files are served without invoking the Worker;
  // only /api/* runs Worker code (keeps us well under 100k requests/day).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cached lookup verdicts only (free tier: 1,000 writes/day), never counters.
  // "bluebench-verdicts", created by Wrangler's auto-provisioning on the first M3 deploy. Pinned so a
  // failed deploy can't make Wrangler try to create it again (it then fails on the duplicate name).
  "kv_namespaces": [{ "binding": "VERDICTS", "id": "6accf125a6524e5f9aa9882a44a055a8" }],
  "durable_objects": {
    "bindings": [
      // One instance per upstream provider: token bucket + daily budget.
      { "name": "PROVIDER_QUOTA", "class_name": "ProviderQuota" },
      // Daily lookup caps per session and per IP group.
      { "name": "USAGE", "class_name": "UsageCounter" }
    ]
  },
  // Free plan requires SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProviderQuota", "UsageCounter"] }],
  // Per-minute limits, per session token and per IP (IPv6 grouped by /64).
  "ratelimits": [
    { "name": "TOKEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Public Turnstile site key (invisible widget for bluebench.dev). Empty = lookups switched off.
    // Invisible mode requires our privacy policy (apps/web/src/pages/PrivacyPage.tsx) to reference
    // Cloudflare's Turnstile Privacy Addendum.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFT1Dg5bCHUCflEe"
  },
  // Secrets (wrangler secret put): TURNSTILE_SECRET_KEY, SESSION_SECRET, ABUSECH_AUTH_KEY, SAFE_BROWSING_API_KEY
  "observability": { "enabled": false },
  "send_metrics": false
}
